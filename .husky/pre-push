#!/usr/bin/env sh

branch="$(git rev-parse --abbrev-ref HEAD)"
remote_name="$1"

upstream_url="$(git remote get-url upstream 2>/dev/null)"
current_remote_url="$(git remote get-url "$remote_name" 2>/dev/null)"

if [ "$branch" = "main" ] && [ "$current_remote_url" = "$upstream_url" ]; then
  echo "Push to upstream/main is forbidden."
  exit 1
fi