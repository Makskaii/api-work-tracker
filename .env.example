BASE_URL=/devapps/work-tracker
API_URL=https://crm.evolution-soft.ru/rest/3/*****/
PORT=3001
FRONTEND_URL=http://localhost:5173


DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=app_pass
DB_NAME=analytics_db

REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL_SECONDS=86400
REDIS_CACHE_TIMEZONE=Europe/Moscow

# Server-only credentials of the installed Bitrix24 Work Tracker application.
# Never copy these into VITE_* values or the frontend bundle.
BITRIX_OAUTH_CLIENT_ID=
BITRIX_OAUTH_CLIENT_SECRET=
BITRIX_OAUTH_MEMBER_ID=
BITRIX_OAUTH_ORIGIN=https://oauth.bitrix24.tech
BITRIX_OAUTH_REDIRECT_URI=https://crm.evolution-soft.ru/devapps/work-tracker
# Generate once with: openssl rand -hex 32. Retain across container restarts.
BITRIX_OAUTH_SESSION_KEY=
EMPLOYEE_AUTH_ENFORCE=true
